    "Dictionaries work offline. Download or delete them in Folito on your iPhone: Settings, Dictionaries." : {
      "comment" : "Watch settings footer under the installed dictionaries",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörterbücher funktionieren offline. Lade oder lösche sie in Folito auf deinem iPhone: Einstellungen, Wörterbücher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los diccionarios funcionan sin conexión. Descárgalos o elimínalos en Folito en tu iPhone: Ajustes, Diccionarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dictionnaires fonctionnent hors ligne. Téléchargez-les ou supprimez-les dans Folito sur votre iPhone : Réglages, Dictionnaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dizionari funzionano offline. Scaricali o eliminali in Folito su iPhone: Impostazioni, Dizionari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辞書はオフラインで使えます。ダウンロードや削除はiPhoneのFolitoで行います：設定、辞書。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dicionários funcionam offline. Baixe ou apague-os no Folito no iPhone: Ajustes, Dicionários."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词典可离线使用。请在 iPhone 上的 Folito 中下载或删除：设置，词典。"
          }
        }
      }
    },
    "Your session has ended. Sign in again in Folito on your iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión ha caducado. Vuelve a iniciar sesión en Folito en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session a expiré. Reconnectez-vous dans Folito sur votre iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Sitzung ist abgelaufen. Melde dich in Folito auf deinem iPhone erneut an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione è scaduta. Accedi di nuovo in Folito sull’iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sessão terminou. Entre novamente no Folito no seu iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが終了しました。iPhoneのFolitoでもう一度サインインしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话已结束。请在 iPhone 上的 Folito 中重新登录。"
          }
        }
      }
    },
    "Sync is optional and off. Reading works fully offline. To sync progress with KOReader Sync or Readest, set it up in the iPhone app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización es opcional y está desactivada. La lectura funciona sin conexión. Para sincronizar el progreso con KOReader Sync o Readest, configúrala en la app del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est facultative et désactivée. La lecture fonctionne entièrement hors ligne. Pour synchroniser la progression avec KOReader Sync ou Readest, configurez-la dans l’app iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung ist optional und aus. Lesen funktioniert vollständig offline. Um den Fortschritt mit KOReader Sync oder Readest zu synchronisieren, richte sie in der iPhone-App ein."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione è facoltativa e disattivata. La lettura funziona completamente offline. Per sincronizzare l’avanzamento con KOReader Sync o Readest, configurala nell’app per iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização é opcional e está desativada. A leitura funciona totalmente offline. Para sincronizar o progresso com o KOReader Sync ou o Readest, configure-a no app do iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期は任意で、オフになっています。読書は完全にオフラインで使えます。KOReader SyncまたはReadestと進捗を同期するには、iPhoneアプリで設定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步为可选项，目前已关闭。阅读完全可离线使用。要与 KOReader Sync 或 Readest 同步进度，请在 iPhone App 中设置。"
          }
        }
      }
    },
