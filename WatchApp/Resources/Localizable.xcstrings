    "Can't reach the server. Check that your watch or iPhone is online, then try again." : {
      "comment" : "Sync server status: no connection",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server nicht erreichbar. Prüfe, ob Watch oder iPhone online sind, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al servidor. Comprueba que el reloj o el iPhone tengan conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveur injoignable. Vérifiez que la montre ou l’iPhone est en ligne, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server. Verifica che l’orologio o iPhone siano online, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバに接続できません。Apple WatchまたはiPhoneがオンラインか確認して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor. Verifique se o relógio ou o iPhone está online e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接服务器。请检查手表或 iPhone 是否联网，然后再试一次。"
          }
        }
      }
    },
