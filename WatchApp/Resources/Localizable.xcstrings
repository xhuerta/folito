    "This book was prepared by a newer version of Folito. Update the app on your iPhone and Apple Watch, then send the book again." : {
      "comment" : "Opening a book failed: its file format is newer than this app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Buch wurde von einer neueren Version von Folito vorbereitet. Aktualisiere die App auf iPhone und Apple Watch und sende das Buch erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este libro se preparó con una versión más reciente de Folito. Actualiza la app en el iPhone y el Apple Watch y vuelve a enviar el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce livre a été préparé par une version plus récente de Folito. Mettez à jour l’app sur votre iPhone et votre Apple Watch, puis renvoyez le livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo libro è stato preparato da una versione più recente di Folito. Aggiorna l’app su iPhone e Apple Watch, quindi invia di nuovo il libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このブックは新しいバージョンのFolitoで準備されました。iPhoneとApple WatchのAppをアップデートしてから、ブックを再送信してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este livro foi preparado por uma versão mais recente do Folito. Atualize o app no iPhone e no Apple Watch e envie o livro novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此图书由更新版本的 Folito 准备。请在 iPhone 和 Apple Watch 上更新 App，然后重新发送图书。"
          }
        }
      }
    },
    "This book's file is damaged. Delete it here and send it again from Folito on your iPhone." : {
      "comment" : "Opening a book failed: the stored file could not be read",
      "localizations" : {
        "de" : {
