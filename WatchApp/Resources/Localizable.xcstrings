    "“Words on the wrist,” he said." : {
      "comment" : "Typography preview: sample quotation; use the quotation marks of your language",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Worte am Handgelenk“, sagte er."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "—Palabras en la muñeca —dijo él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Des mots au poignet », dit-il."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Parole al polso», disse lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「手首の上の言葉だ」と彼は言った。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— Palavras no pulso — disse ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“腕上的文字，”他说。"
          }
        }
      }
    },
    "No dictionary on this watch yet. Download one in Folito on your iPhone: Settings, Dictionaries." : {
      "comment" : "Dictionary lookup failed: no offline dictionary is installed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Wörterbuch auf dieser Watch. Lade eins in Folito auf deinem iPhone: Einstellungen, Wörterbücher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay ningún diccionario en este reloj. Descarga uno en Folito en tu iPhone: Ajustes, Diccionarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun dictionnaire sur cette montre pour l’instant. Téléchargez-en un dans Folito sur votre iPhone : Réglages, Dictionnaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun dizionario su questo orologio. Scaricane uno in Folito su iPhone: Impostazioni, Dizionari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このWatchにはまだ辞書がありません。iPhoneのFolitoでダウンロードしてください：設定、辞書。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há dicionários neste relógio. Baixe um no Folito no iPhone: Ajustes, Dicionários."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此手表上还没有词典。请在 iPhone 上的 Folito 中下载：设置，词典。"
          }
        }
      }
    },
    "A dictionary on this watch is damaged. Delete it in Folito on your iPhone and download it again." : {
      "comment" : "Dictionary lookup failed: an installed dictionary file could not be read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wörterbuch auf dieser Watch ist beschädigt. Lösche es in Folito auf deinem iPhone und lade es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un diccionario de este reloj está dañado. Elimínalo en Folito en tu iPhone y vuelve a descargarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dictionnaire de cette montre est endommagé. Supprimez-le dans Folito sur votre iPhone, puis téléchargez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dizionario su questo orologio è danneggiato. Eliminalo in Folito su iPhone e scaricalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このWatchの辞書が破損しています。iPhoneのFolitoで削除して、もう一度ダウンロードしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dicionário neste relógio está danificado. Apague-o no Folito no iPhone e baixe-o novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此手表上的一本词典已损坏。请在 iPhone 上的 Folito 中删除它，然后重新下载。"
          }
        }
      }
    },
    "Definitions from %@ by its contributors, under the %@ licence. Compiled by %@. Shortened and reformatted by Folito." : {
      "comment" : "Dictionary credit. 1: data source (Wiktionary), 2: licence (CC BY-SA 4.0), 3: who compiled the file (reader.dict)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definitionen aus %1$@ von dessen Mitwirkenden, unter der Lizenz %2$@. Zusammengestellt von %3$@. Von Folito gekürzt und neu formatiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definiciones de %1$@, por sus colaboradores, con licencia %2$@. Recopiladas por %3$@. Acortadas y reformateadas por Folito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définitions issues de %1$@, par ses contributeurs, sous licence %2$@. Compilées par %3$@. Abrégées et remises en forme par Folito."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definizioni da %1$@, a cura dei suoi contributori, con licenza %2$@. Raccolte da %3$@. Abbreviate e riformattate da Folito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定義の出典：%1$@の投稿者（%2$@ライセンス）。%3$@が編集。Folitoが短縮・再整形。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
