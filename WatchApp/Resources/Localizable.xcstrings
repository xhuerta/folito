    "With Increase Contrast on, every theme uses stronger colors. Bold Text also makes the book text bold." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Kontrast erhöhen“ aktiviert ist, verwendet jedes Design kräftigere Farben. „Fetter Text“ macht auch den Buchtext fett."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Aumentar contraste activado, todos los temas usan colores más intensos. Texto en negrita también pone en negrita el texto del libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque « Augmenter le contraste » est activé, chaque thème utilise des couleurs plus marquées. « Texte en gras » met aussi le texte du livre en gras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “Aumenta contrasto” attivo, ogni tema usa colori più marcati. “Testo in grassetto” rende in grassetto anche il testo del libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“コントラストを上げる”がオンのときは、どのテーマもより濃い色を使用します。“文字を太くする”をオンにすると、ブックの本文も太字になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Aumentar Contraste ativado, todos os temas usam cores mais fortes. Texto em Negrito também deixa o texto do livro em negrito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“增强对比度”后，所有主题都会使用更鲜明的颜色。“粗体文本”也会让图书正文显示为粗体。"
          }
        }
      }
    },
    "With Match System Text Size on, the text size follows the Text Size setting of your Apple Watch, starting from the size above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Systemtextgröße verwenden“ aktiviert ist, folgt die Textgröße der Einstellung „Textgröße“ deiner Apple Watch, ausgehend von der Größe oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Igualar tamaño de texto del sistema activado, el tamaño del texto sigue el ajuste Tamaño del texto del Apple Watch, a partir del tamaño anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque « Suivre la taille du texte du système » est activé, la taille du texte suit le réglage Taille du texte de votre Apple Watch, à partir de la taille ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “Usa dimensioni testo di sistema” attivo, le dimensioni del testo seguono l’impostazione Dimensioni testo di Apple Watch, partendo dalle dimensioni sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システムの文字サイズに合わせる”がオンのときは、上のサイズを基準に、Apple Watchの“文字サイズ”設定に合わせて文字サイズが変わります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Usar Tamanho do Texto do Sistema ativado, o tamanho do texto segue o ajuste Tamanho do Texto do Apple Watch, a partir do tamanho acima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“匹配系统文字大小”后，文字大小会以上方的大小为基准，跟随 Apple Watch 的“文字大小”设置变化。"
          }
        }
      }
    },
