    "It was a bright cold day in April, and the clocks were striking thirteen." : {
      "comment" : "Typography preview: sample paragraph (opening line of Orwell's 1984; use the published translation if there is one). Must contain the words translated for 'bright' and 'cold' exactly as written there.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es war ein strahlend kalter Apriltag, und die Uhren schlugen dreizehn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era un día luminoso y frío de abril y los relojes daban las trece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’était une journée d’avril froide et claire, et les horloges sonnaient treize heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era una luminosa e fredda giornata d’aprile, e gli orologi battevano tredici colpi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四月の晴れた寒い日で、時計が十三時を打っていた。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era um dia luminoso e frio de abril, e os relógios davam treze horas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四月间，天气寒冷晴朗，钟敲了十三下。"
          }
        }
      }
    },
    "Its reading position on this watch is removed too. You can send the book again from your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leseposition auf dieser Watch wird ebenfalls entfernt. Du kannst das Buch erneut vom iPhone senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se elimina su posición de lectura en este reloj. Puedes volver a enviar el libro desde el iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa position de lecture sur cette montre est aussi supprimée. Vous pouvez renvoyer le livre depuis votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene rimossa anche la posizione di lettura su questo orologio. Puoi inviare di nuovo il libro da iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple Watch上の読書位置も削除されます。ブックはiPhoneから再送信できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A posição de leitura neste relógio também é removida. Você pode enviar o livro novamente pelo iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此手表上的阅读位置也会被移除。你可以从 iPhone 重新发送该图书。"
          }
        }
      }
    },
