    "Import an EPUB file to read it on your Apple Watch. You can also open EPUB files from the Files app or the share sheet. Books are sent to your watch automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere eine EPUB-Datei, um sie auf deiner Apple Watch zu lesen. Du kannst EPUB-Dateien auch in der App „Dateien“ oder über das Teilen-Menü öffnen. Bücher werden automatisch an deine Watch gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un archivo EPUB para leerlo en tu Apple Watch. También puedes abrir archivos EPUB desde la app Archivos o el menú Compartir. Los libros se envían al reloj automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un fichier EPUB pour le lire sur votre Apple Watch. Vous pouvez aussi ouvrir des fichiers EPUB depuis l’app Fichiers ou la feuille de partage. Les livres sont envoyés automatiquement à votre montre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un file EPUB per leggerlo su Apple Watch. Puoi anche aprire i file EPUB dall’app File o dal menu Condividi. I libri vengono inviati automaticamente all’orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EPUBファイルを読み込むと、Apple Watchで読むことができます。“ファイル”Appや共有シートからEPUBファイルを開くこともできます。ブックは自動的にApple Watchに送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe um arquivo EPUB para lê-lo no Apple Watch. Você também pode abrir arquivos EPUB no app Arquivos ou no menu Compartilhar. Os livros são enviados ao relógio automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入 EPUB 文件即可在 Apple Watch 上阅读。你也可以从“文件”App 或共享表单打开 EPUB 文件。图书会自动发送到你的手表。"
          }
        }
      }
    },
