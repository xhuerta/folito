    "Only details your book is missing are added. The book file itself is not changed, and you can remove online details at any time." : {
      "comment" : "Find Details Online: note below the actions",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se añaden los detalles que le faltan a tu libro. El archivo del libro no se modifica y puedes quitar los detalles en línea cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les détails manquants sont ajoutés. Le fichier du livre n’est pas modifié, et vous pouvez retirer les détails en ligne à tout moment."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur fehlende Details hinzugefügt. Die Buchdatei selbst wird nicht verändert, und du kannst Online-Details jederzeit wieder entfernen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
