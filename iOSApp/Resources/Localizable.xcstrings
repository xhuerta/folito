    "Open an EPUB from the Files app or the share sheet and choose Folito, or tap Import EPUB in the Library." : {
      "comment" : "Welcome tour: step 1 description",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un EPUB desde la app Archivos o el menú Compartir y elige Folito, o toca Importar EPUB en la Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez un EPUB depuis l’app Fichiers ou la feuille de partage et choisissez Folito, ou touchez Importer un EPUB dans la Bibliothèque."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ein EPUB in der App „Dateien“ oder über das Teilen-Menü und wähle Folito, oder tippe in der Bibliothek auf „EPUB importieren“."
          }
        },
        "it" : {
          "stringUnit" : {
