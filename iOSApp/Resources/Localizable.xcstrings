    "Something went wrong while converting “%@”. Try again; if it keeps failing, the file may use a format Folito doesn’t support." : {
      "comment" : "Generic import error; the placeholder is the file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Konvertieren von „%@“ ist ein Fehler aufgetreten. Versuche es erneut. Wenn es weiterhin fehlschlägt, verwendet die Datei möglicherweise ein Format, das Folito nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha producido un error al convertir “%@”. Vuelve a intentarlo; si sigue fallando, es posible que el archivo use un formato que Folito no admite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu lors de la conversion de « %@ ». Réessayez ; si l’erreur persiste, le fichier utilise peut-être un format non pris en charge par Folito."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un problema durante la conversione di “%@”. Riprova; se continua a non riuscire, il file potrebbe usare un formato non supportato da Folito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の変換中に問題が発生しました。もう一度お試しください。失敗が続く場合は、Folitoが対応していない形式のファイルである可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro ao converter “%@”. Tente novamente; se continuar falhando, o arquivo pode usar um formato não compatível com o Folito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转换“%@”时出错。请再试一次；如果仍然失败，该文件可能使用了 Folito 不支持的格式。"
          }
        }
      }
    },
