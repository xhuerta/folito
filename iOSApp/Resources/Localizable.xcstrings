    "Sync is off. Your login was removed from this iPhone and your Apple Watch." : {
      "comment" : "Sync status after turning sync off",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync ist aus. Deine Anmeldedaten wurden von diesem iPhone und deiner Apple Watch entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización desactivada. Se ha eliminado tu inicio de sesión de este iPhone y de tu Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisation désactivée. Votre identifiant a été supprimé de cet iPhone et de votre Apple Watch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizzazione disattivata. Le credenziali sono state rimosse da questo iPhone e da Apple Watch."
