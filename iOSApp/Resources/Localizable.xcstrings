          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待 Apple Watch"
          }
        }
      }
    },
    "Works with any KOReader Sync-compatible server, for example KOReader’s, Readest’s or one you host yourself. Sync stays off until you save a username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert mit jedem KOReader-Sync-kompatiblen Server, etwa dem von KOReader, dem von Readest oder einem selbst gehosteten. Sync bleibt aus, bis du einen Benutzernamen und ein Passwort sicherst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con cualquier servidor compatible con KOReader Sync, por ejemplo el de KOReader, el de Readest o uno alojado por ti. La sincronización permanece desactivada hasta que guardes un nombre de usuario y una contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec tout serveur compatible KOReader Sync, par exemple celui de KOReader, celui de Readest ou un serveur que vous hébergez. La synchronisation reste désactivée tant que vous n’avez pas enregistré de nom d’utilisateur et de mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona con qualsiasi server compatibile con KOReader Sync, ad esempio quello di KOReader, quello di Readest o uno ospitato da te. La sincronizzazione resta disattivata finché non salvi nome utente e password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KOReader Syncに対応したサーバ（KOReaderやReadestのサーバ、または自分でホストするサーバなど）で利用できます。ユーザ名とパスワードを保存するまで、同期はオフのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona com qualquer servidor compatível com o KOReader Sync, por exemplo o do KOReader, o do Readest ou um hospedado por você. A sincronização fica desativada até você salvar um nome de usuário e uma senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于任何兼容 KOReader Sync 的服务器，例如 KOReader 或 Readest 的服务器，或你自己托管的服务器。在你存储用户名和密码之前，同步会保持关闭。"
          }
        }
      }
    },
    "Folito Isn’t on Your Apple Watch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folito ist nicht auf deiner Apple Watch"
