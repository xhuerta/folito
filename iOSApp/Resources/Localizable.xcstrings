    "Waiting for Apple Watch" : {
      "comment" : "Library row: the book will be sent when the watch is available",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten auf Apple Watch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando al Apple Watch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de l’Apple Watch"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di Apple Watch"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchを待機中"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando o Apple Watch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待 Apple Watch"
          }
        }
      }
    },
    "Works with any KOReader Sync-compatible server, for example KOReader’s, Readest’s or one you host yourself. Sync stays off until you save a username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert mit jedem KOReader-Sync-kompatiblen Server, etwa dem von KOReader, dem von Readest oder einem selbst gehosteten. Sync bleibt aus, bis du einen Benutzernamen und ein Passwort sicherst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con cualquier servidor compatible con KOReader Sync, por ejemplo el de KOReader, el de Readest o uno alojado por ti. La sincronización permanece desactivada hasta que guardes un nombre de usuario y una contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec tout serveur compatible KOReader Sync, par exemple celui de KOReader, celui de Readest ou un serveur que vous hébergez. La synchronisation reste désactivée tant que vous n’avez pas enregistré de nom d’utilisateur et de mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona con qualsiasi server compatibile con KOReader Sync, ad esempio quello di KOReader, quello di Readest o uno ospitato da te. La sincronizzazione resta disattivata finché non salvi nome utente e password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KOReader Syncに対応したサーバ（KOReaderやReadestのサーバ、または自分でホストするサーバなど）で利用できます。ユーザ名とパスワードを保存するまで、同期はオフのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona com qualquer servidor compatível com o KOReader Sync, por exemplo o do KOReader, o do Readest ou um hospedado por você. A sincronização fica desativada até você salvar um nome de usuário e uma senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于任何兼容 KOReader Sync 的服务器，例如 KOReader 或 Readest 的服务器，或你自己托管的服务器。在你存储用户名和密码之前，同步会保持关闭。"
          }
        }
      }
    },
    "WristReader Isn’t on Your Apple Watch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader ist nicht auf deiner Apple Watch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader no está en tu Apple Watch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader n’est pas sur votre Apple Watch"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader non è su Apple Watch"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReaderがApple Watchにありません"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O WristReader Não Está no Apple Watch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch 上没有 WristReader"
          }
        }
      }
    },
    "WristReader couldn’t read “%@”. If it is stored in iCloud Drive or another cloud service, open it once in the Files app so it is downloaded, then try again." : {
      "comment" : "Alert message; the placeholder is the file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader konnte „%@“ nicht lesen. Wenn die Datei in iCloud Drive oder einem anderen Cloud-Dienst gespeichert ist, öffne sie einmal in der App „Dateien“, damit sie geladen wird, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader no ha podido leer “%@”. Si está guardado en iCloud Drive u otro servicio en la nube, ábrelo una vez en la app Archivos para que se descargue y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader n’a pas pu lire « %@ ». S’il est stocké dans iCloud Drive ou un autre service cloud, ouvrez-le une fois dans l’app Fichiers pour le télécharger, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader non è riuscito a leggere “%@”. Se è archiviato su iCloud Drive o su un altro servizio cloud, aprilo una volta nell’app File per scaricarlo, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReaderは「%@」を読み取れませんでした。iCloud Driveやほかのクラウドサービスに保存されている場合は、“ファイル”Appで一度開いてダウンロードしてから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O WristReader não conseguiu ler “%@”. Se ele estiver no iCloud Drive ou em outro serviço de nuvem, abra-o uma vez no app Arquivos para que seja baixado e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader 无法读取“%@”。如果该文件存储在 iCloud 云盘或其他云服务中，请先在“文件”App 中打开一次以下载它，然后再试一次。"
          }
        }
      }
    },
    "WristReader uses these open-source components. Tap one to read its licence." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader verwendet diese Open-Source-Komponenten. Tippe auf eine, um ihre Lizenz zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader usa estos componentes de código abierto. Toca uno para leer su licencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader utilise ces composants open source. Touchez-en un pour lire sa licence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader utilizza questi componenti open source. Toccane uno per leggerne la licenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReaderは以下のオープンソースコンポーネントを使用しています。タップするとライセンスを読めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O WristReader usa estes componentes de código aberto. Toque em um para ler a licença."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader 使用了以下开源组件。轻点任一组件即可阅读其许可证。"
          }
        }
      }
    },
    "WristReader works fully without an account. Sync is optional: it only lets you continue the same book on other readers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader funktioniert vollständig ohne Account. Sync ist optional: Damit kannst du dasselbe Buch nur auf anderen Readern weiterlesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader funciona por completo sin cuenta. La sincronización es opcional: solo sirve para continuar el mismo libro en otros lectores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader fonctionne entièrement sans compte. La synchronisation est facultative : elle permet seulement de poursuivre le même livre sur d’autres liseuses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader funziona completamente senza account. La sincronizzazione è opzionale: serve solo a continuare lo stesso libro su altri lettori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReaderはアカウントなしですべての機能を使えます。同期はオプションで、ほかのリーダーで同じブックの続きを読むためだけに使います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O WristReader funciona totalmente sem conta. A sincronização é opcional: ela só permite continuar o mesmo livro em outros leitores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WristReader 无需账户即可完整使用。同步是可选的：它仅用于在其他阅读器上继续阅读同一本书。"
          }
        }
      }
    },
