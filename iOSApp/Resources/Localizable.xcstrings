    "Your Readest storage is full. Delete books from Readest, or get more storage in the Readest app, then try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu almacenamiento de Readest está lleno. Elimina libros de Readest u obtén más espacio en la app Readest y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre stockage Readest est plein. Supprimez des livres de Readest ou obtenez plus d’espace dans l’app Readest, puis réessayez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Readest-Speicher ist voll. Lösche Bücher aus Readest oder hol dir in der Readest-App mehr Speicher und versuche es erneut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio di Readest è pieno. Elimina dei libri da Readest o ottieni più spazio nell’app Readest, poi riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu armazenamento do Readest está cheio. Apague livros do Readest ou obtenha mais espaço no app Readest e tente novamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Readestのストレージがいっぱいです。Readestからブックを削除するか、Readestアプリでストレージを追加してから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Readest 存储空间已满。请从 Readest 删除一些图书，或在 Readest App 中获取更多存储空间，然后重试。"
          }
        }
      }
    },
