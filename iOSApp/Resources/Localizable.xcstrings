    "The iPhone app sends each book to Folito on your Apple Watch. Books reach the watch only through the iPhone app, so keep it installed." : {
      "comment" : "Welcome tour: step 2 description",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app del iPhone envía cada libro a Folito en tu Apple Watch. Los libros solo llegan al reloj a través de la app del iPhone, así que no la desinstales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app iPhone envoie chaque livre à Folito sur votre Apple Watch. Les livres n’arrivent sur la montre que par l’app iPhone : gardez-la installée."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iPhone-App sendet jedes Buch an Folito auf deiner Apple Watch. Bücher kommen nur über die iPhone-App auf die Watch, also lass sie installiert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app per iPhone invia ogni libro a Folito su Apple Watch. I libri arrivano all’orologio solo tramite l’app per iPhone, quindi tienila installata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app do iPhone envia cada livro ao Folito no Apple Watch. Os livros só chegam ao relógio pelo app do iPhone, então mantenha-o instalado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのAppが各ブックをApple WatchのFolitoに送信します。ブックはiPhoneのAppを通じてのみWatchに届くので、iPhoneのAppは削除しないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone App 会把每本图书发送到 Apple Watch 上的 Folito。图书只能通过 iPhone App 传到手表，所以请保留它。"
          }
        }
      }
    },
    "3. Read on your watch" : {
      "comment" : "Welcome tour: step 3 title",
      "localizations" : {
        "es" : {
