    "The book is removed from your Readest account and from every device that syncs with it. This can’t be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El libro se eliminará de tu cuenta de Readest y de todos los dispositivos que se sincronizan con ella. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le livre est supprimé de votre compte Readest et de tous les appareils qui se synchronisent avec lui. Cette action est irréversible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Buch wird aus deinem Readest-Account und von allen Geräten entfernt, die damit synchronisieren. Dies kann nicht widerrufen werden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il libro viene rimosso dal tuo account Readest e da tutti i dispositivi sincronizzati. L’operazione non può essere annullata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
