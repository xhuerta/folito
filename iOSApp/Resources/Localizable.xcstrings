    "A secure connection to the server couldn’t be made. The server’s certificate isn’t trusted by this iPhone." : {
      "comment" : "Sync error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte keine sichere Verbindung zum Server hergestellt werden. Dieses iPhone vertraut dem Zertifikat des Servers nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido establecer una conexión segura con el servidor. Este iPhone no confía en el certificado del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’établir une connexion sécurisée avec le serveur. Le certificat du serveur n’est pas approuvé par cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile stabilire una connessione sicura con il server. Il certificato del server non è considerato attendibile da questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバとの安全な接続を確立できませんでした。このiPhoneはサーバの証明書を信頼していません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível estabelecer uma conexão segura com o servidor. Este iPhone não confia no certificado do servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法与服务器建立安全连接。此 iPhone 不信任该服务器的证书。"
          }
        }
      }
    },
