    "Pair an Apple Watch with this iPhone to read on your wrist. Books you import stay here and are sent once a watch is paired." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopple eine Apple Watch mit diesem iPhone, um am Handgelenk zu lesen. Importierte Bücher bleiben hier und werden gesendet, sobald eine Watch gekoppelt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlaza un Apple Watch con este iPhone para leer en tu muñeca. Los libros que importes se quedan aquí y se envían cuando enlaces un reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumelez une Apple Watch avec cet iPhone pour lire à votre poignet. Les livres que vous importez restent ici et sont envoyés dès qu’une montre est jumelée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina un Apple Watch a questo iPhone per leggere al polso. I libri che importi restano qui e vengono inviati quando abbini un orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple WatchをこのiPhoneとペアリングすると、手首で読書できます。読み込んだブックはここに保存され、ペアリング後に送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emparelhe um Apple Watch com este iPhone para ler no pulso. Os livros importados ficam aqui e são enviados quando um relógio for emparelhado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Apple Watch 与此 iPhone 配对即可在手腕上阅读。导入的图书会保留在这里，并在配对手表后发送。"
          }
        }
      }
    },
