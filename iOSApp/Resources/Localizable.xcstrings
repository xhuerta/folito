    "Signed in. Sync is on. The session is sent to your Apple Watch now, or as soon as the watch app is installed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión iniciada. La sincronización está activada. La sesión se envía a tu Apple Watch ahora, o en cuanto se instale la app del reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté. La synchronisation est activée. La session est envoyée à votre Apple Watch maintenant, ou dès que l’app de la montre est installée."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet. Die Synchronisierung ist an. Die Sitzung wird jetzt an deine Apple Watch gesendet oder sobald die Watch-App installiert ist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso effettuato. La sincronizzazione è attiva. La sessione viene inviata al tuo Apple Watch ora, o non appena l’app dell’orologio è installata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessão iniciada. A sincronização está ativada. A sessão é enviada ao seu Apple Watch agora, ou assim que o app do relógio for instalado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしました。同期はオンです。セッションは今すぐ、またはWatchアプリがインストールされ次第Apple Watchに送信されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已登录。同步已开启。会话将立即发送到你的 Apple Watch，或在手表 App 安装后发送。"
          }
        }
      }
    },
    "Syncs with Readest Cloud, used by the Readest apps and by the Readest plugin for KOReader (for example on a Kobo). Folito is not made by Readest." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza con Readest Cloud, que usan las apps de Readest y el plugin de Readest para KOReader (por ejemplo, en un Kobo). Folito no es un producto de Readest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronise avec Readest Cloud, utilisé par les apps Readest et par le plugin Readest pour KOReader (par exemple sur une Kobo). Folito n’est pas développé par Readest."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert mit Readest Cloud, das von den Readest-Apps und vom Readest-Plug-in für KOReader (zum Beispiel auf einem Kobo) genutzt wird. Folito stammt nicht von Readest."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza con Readest Cloud, usato dalle app Readest e dal plugin Readest per KOReader (ad esempio su un Kobo). Folito non è realizzato da Readest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza com o Readest Cloud, usado pelos apps do Readest e pelo plugin do Readest para KOReader (por exemplo, em um Kobo). O Folito não é feito pelo Readest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadestアプリとKOReader用Readestプラグイン（Koboなど）が使うReadest Cloudと同期します。FolitoはReadestの製品ではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 Readest Cloud 同步。Readest App 和 KOReader 的 Readest 插件（例如在 Kobo 上）都使用此服务。Folito 并非 Readest 出品。"
          }
        }
      }
    },
    "Readest sent a response Folito couldn’t understand. Try again later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
