        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期はオフです。このiPhoneとApple Watchからログイン情報を削除しました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
