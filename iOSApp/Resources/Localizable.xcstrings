          }
        }
      }
    },
    "“%@” is too large to convert for Apple Watch. Try a smaller edition of the book, for example one without images." : {
      "comment" : "Import error; the placeholder is the file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist zu groß, um für die Apple Watch konvertiert zu werden. Versuche eine kleinere Ausgabe des Buchs, etwa eine ohne Bilder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” es demasiado grande para convertirlo para el Apple Watch. Prueba con una edición más pequeña del libro, por ejemplo una sin imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est trop volumineux pour être converti pour l’Apple Watch. Essayez une édition plus légère du livre, par exemple sans images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è troppo grande per essere convertito per Apple Watch. Prova un’edizione più leggera del libro, ad esempio senza immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はサイズが大きすぎるため、Apple Watch用に変換できません。画像のない版など、より小さい版のブックをお試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” é grande demais para ser convertido para o Apple Watch. Tente uma edição menor do livro, por exemplo uma sem imagens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”太大，无法为 Apple Watch 转换。请尝试该书较小的版本，例如不含图片的版本。"
          }
        }
      }
    },
    "“%@” isn’t a valid EPUB file or is damaged. Try downloading or exporting the book again." : {
      "comment" : "Import error; the placeholder is the file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine gültige EPUB-Datei oder ist beschädigt. Lade oder exportiere das Buch erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un archivo EPUB válido o está dañado. Vuelve a descargar o exportar el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un fichier EPUB valide ou est endommagé. Essayez de télécharger ou d’exporter à nouveau le livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è un file EPUB valido o è danneggiato. Prova a scaricare o esportare di nuovo il libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は有効なEPUBファイルではないか、破損しています。ブックをもう一度ダウンロードまたは書き出してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é um arquivo EPUB válido ou está danificado. Tente baixar ou exportar o livro novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是有效的 EPUB 文件或已损坏。请尝试重新下载或导出该图书。"
          }
        }
      }
    },
    "“Words on the wrist,” he said." : {
      "comment" : "Typography preview: sample quotation; use the quotation marks of your language",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Worte am Handgelenk“, sagte er."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "—Palabras en la muñeca —dijo él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Des mots au poignet », dit-il."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Parole al polso», disse lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「手首の上の言葉だ」と彼は言った。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— Palavras no pulso — disse ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“腕上的文字，”他说。"
          }
        }
      }
    },
