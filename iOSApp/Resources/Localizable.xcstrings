    "Reading progress is synced with the server below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lesefortschritt wird mit dem unten angegebenen Server synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso de lectura se sincroniza con el servidor indicado abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression de lecture est synchronisée avec le serveur ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progressi di lettura vengono sincronizzati con il server qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読書の進捗は下のサーバと同期されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso de leitura é sincronizado com o servidor abaixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阅读进度会与下方的服务器同步。"
          }
        }
      }
    },
    "Removes the login from this iPhone and from your Apple Watch, and clears progress waiting to sync. Your books and reading positions are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die Anmeldedaten von diesem iPhone und deiner Apple Watch und löscht noch nicht synchronisierten Fortschritt. Deine Bücher und Lesepositionen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el inicio de sesión de este iPhone y de tu Apple Watch, y borra el progreso pendiente de sincronizar. Se conservan tus libros y posiciones de lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime l’identifiant de cet iPhone et de votre Apple Watch, et efface la progression en attente de synchronisation. Vos livres et positions de lecture sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le credenziali da questo iPhone e da Apple Watch e cancella i progressi in attesa di sincronizzazione. I libri e le posizioni di lettura vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneとApple Watchからログイン情報を削除し、同期待ちの進捗を消去します。ブックと読書位置は保持されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove o login deste iPhone e do Apple Watch e apaga o progresso aguardando sincronização. Seus livros e posições de leitura são mantidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此 iPhone 和你的 Apple Watch 中移除登录信息，并清除等待同步的进度。你的图书和阅读位置会保留。"
          }
        }
      }
    },
    "Reset all reading settings to their defaults?" : {
