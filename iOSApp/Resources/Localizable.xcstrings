          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folito n’est pas sur votre Apple Watch"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folito non è su Apple Watch"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
