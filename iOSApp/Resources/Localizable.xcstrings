    "Open the Watch app on this iPhone, find WristReader under Available Apps and tap Install. Your books are sent automatically once it’s installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die App „Watch“ auf diesem iPhone, suche WristReader unter „Verfügbare Apps“ und tippe auf „Installieren“. Deine Bücher werden nach der Installation automatisch gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app Watch en este iPhone, busca WristReader en “Apps disponibles” y toca Instalar. Tus libros se envían automáticamente una vez instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’app Watch sur cet iPhone, recherchez WristReader sous « Apps disponibles » et touchez Installer. Vos livres sont envoyés automatiquement une fois l’app installée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri l’app Watch su questo iPhone, trova WristReader in “App disponibili” e tocca Installa. I libri vengono inviati automaticamente dopo l’installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneでWatch Appを開き、“利用可能なApp”でWristReaderを探して“インストール”をタップしてください。インストールされると、ブックは自動的に送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o app Watch neste iPhone, encontre o WristReader em Apps Disponíveis e toque em Instalar. Seus livros são enviados automaticamente após a instalação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此 iPhone 上打开 Watch App，在“可用 App”下找到 WristReader 并轻点“安装”。安装后，你的图书会自动发送。"
          }
        }
      }
    },
    "Opens in your web browser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird in deinem Webbrowser geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abre en el navegador web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ouvre dans votre navigateur web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si apre nel browser web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webブラウザで開きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre no navegador."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在网页浏览器中打开。"
          }
        }
      }
    },
    "Optional. Continue the same book in KOReader and other compatible reading apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Lies dasselbe Buch in KOReader und anderen kompatiblen Lese-Apps weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Continúa el mismo libro en KOReader y otras apps de lectura compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Poursuivez le même livre dans KOReader et d’autres apps de lecture compatibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opzionale. Continua lo stesso libro in KOReader e in altre app di lettura compatibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オプション。KOReaderや対応するほかの読書Appで同じブックの続きを読めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Continue o mesmo livro no KOReader e em outros apps de leitura compatíveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。在 KOReader 和其他兼容的阅读 App 中继续阅读同一本书。"
          }
        }
      }
    },
    "Optional: Connect a Sync Server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: Sync-Server verbinden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional: conectar un servidor de sincronización"
          }
        },
        "fr" : {
          "stringUnit" : {
