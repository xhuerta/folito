    "Internet Archive Privacy Policy" : {
      "comment" : "Settings link: the privacy policy of the Internet Archive, which runs Open Library",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Política de privacidad de Internet Archive"
