    "Open the Watch app on this iPhone, find Folito under Available Apps and tap Install. Your books are sent automatically once it’s installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die App „Watch“ auf diesem iPhone, suche Folito unter „Verfügbare Apps“ und tippe auf „Installieren“. Deine Bücher werden nach der Installation automatisch gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app Watch en este iPhone, busca Folito en “Apps disponibles” y toca Instalar. Tus libros se envían automáticamente una vez instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’app Watch sur cet iPhone, recherchez Folito sous « Apps disponibles » et touchez Installer. Vos livres sont envoyés automatiquement une fois l’app installée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri l’app Watch su questo iPhone, trova Folito in “App disponibili” e tocca Installa. I libri vengono inviati automaticamente dopo l’installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneでWatch Appを開き、“利用可能なApp”でFolitoを探して“インストール”をタップしてください。インストールされると、ブックは自動的に送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o app Watch neste iPhone, encontre o Folito em Apps Disponíveis e toque em Instalar. Seus livros são enviados automaticamente após a instalação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此 iPhone 上打开 Watch App，在“可用 App”下找到 Folito 并轻点“安装”。安装后，你的图书会自动发送。"
          }
        }
      }
    },
