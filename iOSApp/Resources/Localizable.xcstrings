    "Books in Readest need a connection. Connect to the internet and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los libros de Readest necesitan conexión. Conéctate a internet y vuelve a intentarlo."
          }
        },
        "fr" : {
