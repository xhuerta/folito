    "http:// is not encrypted. Use it only on your home network: the sync password hash and your reading progress are sent in clear." : {
      "comment" : "Warning under the server URL field",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// ist nicht verschlüsselt. Verwende es nur in deinem Heimnetzwerk: Der Hash des Sync-Passworts und dein Lesefortschritt werden unverschlüsselt gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// no está cifrado. Úsalo solo en tu red doméstica: el hash de la contraseña de sincronización y tu progreso de lectura se envían sin cifrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// n’est pas chiffré. Utilisez-le uniquement sur votre réseau domestique : l’empreinte du mot de passe de synchronisation et votre progression de lecture sont envoyées en clair."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// non è cifrato. Usalo solo sulla rete di casa: l’hash della password di sincronizzazione e i progressi di lettura vengono inviati in chiaro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http://は暗号化されません。自宅のネットワークでのみ使用してください。同期パスワードのハッシュと読書の進捗が暗号化されずに送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// não é criptografado. Use-o apenas na sua rede doméstica: o hash da senha de sincronização e seu progresso de leitura são enviados sem criptografia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// 未加密。请仅在家庭网络中使用：同步密码的哈希值和你的阅读进度将以明文发送。"
          }
        }
      }
    },
    "iOS blocked the unencrypted http:// connection. Use an https:// address, or a local-network address (IP address, .local or a name without dots)." : {
      "comment" : "Sync error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat die unverschlüsselte http://-Verbindung blockiert. Verwende eine https://-Adresse oder eine Adresse im lokalen Netzwerk (IP-Adresse, .local oder ein Name ohne Punkte)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ha bloqueado la conexión http:// sin cifrar. Usa una dirección https:// o una dirección de la red local (dirección IP, .local o un nombre sin puntos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a bloqué la connexion http:// non chiffrée. Utilisez une adresse https:// ou une adresse du réseau local (adresse IP, .local ou un nom sans point)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ha bloccato la connessione http:// non cifrata. Usa un indirizzo https:// o un indirizzo della rete locale (indirizzo IP, .local o un nome senza punti)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSが暗号化されていないhttp://接続をブロックしました。https://アドレス、またはローカルネットワークのアドレス（IPアドレス、.local、またはドットを含まない名前）を使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS bloqueou a conexão http:// sem criptografia. Use um endereço https:// ou um endereço da rede local (endereço IP, .local ou um nome sem pontos)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 阻止了未加密的 http:// 连接。请使用 https:// 地址或局域网地址（IP 地址、.local 或不含点的名称）。"
          }
        }
      }
    },
    "iOS blocks http:// connections to internet hosts, so this will fail. Use https://, or a local address (IP address, .local or a name without dots)." : {
      "comment" : "Warning under the server URL field",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS blockiert http://-Verbindungen zu Internet-Hosts, daher wird dies fehlschlagen. Verwende https:// oder eine lokale Adresse (IP-Adresse, .local oder ein Name ohne Punkte)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS bloquea las conexiones http:// a servidores de internet, así que esto fallará. Usa https:// o una dirección local (dirección IP, .local o un nombre sin puntos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS bloque les connexions http:// vers des hôtes Internet ; cela échouera donc. Utilisez https:// ou une adresse locale (adresse IP, .local ou un nom sans point)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS blocca le connessioni http:// verso host su internet, quindi non funzionerà. Usa https:// o un indirizzo locale (indirizzo IP, .local o un nome senza punti)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSはインターネット上のホストへのhttp://接続をブロックするため、この設定では接続できません。https://、またはローカルアドレス（IPアドレス、.local、またはドットを含まない名前）を使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS bloqueia conexões http:// com hosts da internet, então isso vai falhar. Use https:// ou um endereço local (endereço IP, .local ou um nome sem pontos)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 会阻止连接到互联网主机的 http:// 连接，因此此设置将无法使用。请使用 https:// 或本地地址（IP 地址、.local 或不含点的名称）。"
          }
        }
      }
    },
    "“%@” doesn’t contain any readable chapters." : {
      "comment" : "Import error; the placeholder is the file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
