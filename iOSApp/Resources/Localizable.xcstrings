          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ファイル”Appや共有シートからEPUBを開いてFolitoを選ぶか、ライブラリで“EPUBを読み込む”をタップします。"
          }
        },
