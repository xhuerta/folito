    "Deleting it from this iPhone also removes it from your Apple Watch. It stays in Readest, so you can download it again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo eliminas de este iPhone, también se eliminará de tu Apple Watch. Seguirá en Readest, así que podrás volver a descargarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le supprimer de cet iPhone le supprime aussi de votre Apple Watch. Il reste dans Readest, vous pourrez donc le télécharger à nouveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du es von diesem iPhone löschst, wird es auch von deiner Apple Watch entfernt. Es bleibt in Readest, sodass du es erneut laden kannst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminarlo da questo iPhone lo rimuove anche da Apple Watch. Resta su Readest, quindi puoi scaricarlo di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagá-lo deste iPhone também o remove do seu Apple Watch. Ele continua no Readest, então você pode baixá-lo novamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneから削除すると、Apple Watchからも削除されます。Readestには残るので、もう一度ダウンロードできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此 iPhone 删除也会将其从你的 Apple Watch 移除。它仍保留在 Readest 中，你可以再次下载。"
          }
        }
      }
    },
