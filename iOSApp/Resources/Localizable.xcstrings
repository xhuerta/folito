    "This book was imported before Folito kept the original EPUB file. Import the file again, then upload it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este libro se importó antes de que Folito guardara el archivo EPUB original. Vuelve a importar el archivo y súbelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce livre a été importé avant que Folito conserve le fichier EPUB d’origine. Importez de nouveau le fichier, puis envoyez-le."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Buch wurde importiert, bevor Folito die Original-EPUB-Datei behalten hat. Importiere die Datei erneut und lade sie dann hoch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo libro è stato importato prima che Folito conservasse il file EPUB originale. Importa di nuovo il file, poi caricalo."
