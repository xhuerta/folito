// Shared defaults. Do not put personal values here; use Config/Local.xcconfig.

// Base bundle id of the iPhone app (registered in App Store Connect). The watch app appends ".watchkitapp".
WR_BUNDLE_ID = com.xlahuerta.folito

// User-visible app name (home screen / App Store). Override in Config/Local.xcconfig if needed.
WR_APP_NAME = Folito

// Version shown in the App Store, and the build number. CI overrides both on the xcodebuild
// command line, e.g. `xcodebuild ... CURRENT_PROJECT_VERSION=$GITHUB_RUN_NUMBER`.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// App Group shared by the watch app and its complications (widget extension), used for the reading snapshot
// the complications show. Needs a paid team (register it as described in docs/RELEASE.md). A free Personal
// Team clears the two entitlement settings in Config/Local.xcconfig; the complications then show their
// "Start reading" placeholder.
WR_APP_GROUP = group.$(WR_BUNDLE_ID)
WR_WATCH_ENTITLEMENTS = WatchApp/FolitoWatch.entitlements
WR_WIDGETS_ENTITLEMENTS = WatchWidgets/FolitoWatchWidgets.entitlements

// Empty by default so CI and fresh clones build unsigned.
DEVELOPMENT_TEAM =

// Optional, gitignored per-developer overrides (team id, unique bundle id).
#include? "Local.xcconfig"
