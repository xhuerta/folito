    "Your current book and how far you have read. Tap to keep reading." : {
      "comment" : "Description of the Folito complication / widget in the watch face editor",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein aktuelles Buch und wie weit du gelesen hast. Tippe, um weiterzulesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu libro actual y cuánto has leído. Toca para seguir leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre livre en cours et votre progression. Touchez pour continuer la lecture."
          }
